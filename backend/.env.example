# =============================================================================
# SMSVIBES — Backend Environment Variables Template
# =============================================================================
# Copy this file to `.env` and populate all values before running the server.
# NEVER commit your real `.env` file to version control.
#
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# CENTS LAW: All financial values (available, held, price, amount) MUST be
# processed as integers in USD cents. $1.00 = 100. Store nothing as a float.
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# =============================================================================


# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
NODE_ENV="development"                     # development | production | test
PORT="5000"                                # Express server port
ALLOWED_ORIGINS="https://smsvibes.com,https://www.smsvibes.com"
SSH_PORT="65002"                           # Hostinger Cloud SSH port (PM2/Nginx)


# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# JWT_SECRET must be at least 32 random characters — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change_me_to_at_least_32_random_characters_xxxxxxxxxxxxxxxxxxxx"
JWT_EXPIRES_IN="7d"                        # e.g. 7d | 24h | 3600s

# ENCRYPTION_SECRET must be EXACTLY 32 characters for AES-256-CBC/GCM.
ENCRYPTION_SECRET="change_me_exactly_32_chars______"


# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# MongoDB Atlas connection string (include DB name in the URI).
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority&appName=<appName>"

# Redis — format: redis://:<password>@<host>:<port>
REDIS_URL="redis://:<password>@<host>:<port>"


# -----------------------------------------------------------------------------
# PAYMENTS  (NOWPayments)
# -----------------------------------------------------------------------------
NOWPAYMENTS_API_KEY="your_nowpayments_api_key_here"
NOWPAYMENTS_IPN_SECRET="your_nowpayments_ipn_secret_here"   # Webhook HMAC verification
NOWPAYMENTS_MERCHANT_ID="your_nowpayments_merchant_id_here"


# -----------------------------------------------------------------------------
# EMAIL  (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"